{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "created": {
          ".write": "auth != null && !data.exists() && newData.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "guests": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (newData.val() === true || !newData.exists())) || (!newData.exists() && data.parent().parent().child('host').val() === auth.uid))"
          }
        },
        "fromHost": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
        },
        "fromPlayer": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (newData.parent().parent().child('host').val() === auth.uid || newData.parent().parent().child('guests').child(auth.uid).val() === true)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
