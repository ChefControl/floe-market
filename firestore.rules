rules_version = '2';

// Cloud saves (src/cloud.ts, src/firebase.ts): each player's save is one document, saves/{uid}, which only that
// signed-in player can read or write. The scoreboard (src/scores.ts) is one document per player, scores/{uid}: anyone
// can read it, a page of at most 50 at a time, and only that signed-in player can write it. A bug report (src/report.ts)
// is a document in reports/, which a player signed in with Google can add but no player can read, change or delete;
// the intake workflow (intake/) reads them with its own service account, which these rules don't apply to. Each
// report goes with an update to limits/{uid}, which counts a player's reports: up to 20 in an hour, at least a second
// apart, and the count starts again an hour after its first. config/reports, made by hand in the console, switches
// reports on ({open: true}) and off. Paste these into Firestore's Rules tab in the Firebase console (tests: test/rules/).
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'savedAt', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 100000
        && request.resource.data.savedAt is number;
    }
    match /scores/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'best', 'stage', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.best is number
        && request.resource.data.best >= 0
        && request.resource.data.stage in [1, 2, 3];
    }

    function googleUser(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function jpeg(v) { return str(v, 200000) && v.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'); }

    match /reports/{id} {
      // named the way the game names them (src/report.ts), which the intake relies on for the report's files
      allow create: if id.matches('[A-Za-z0-9]{20}') && googleUser(request.resource.data.uid)
        && get(/databases/$(database)/documents/config/reports).data.open == true
        && request.resource.data.keys().hasAll(['uid', 'at', 'status', 'kind', 'text', 'build', 'device', 'errors'])
        && request.resource.data.keys().hasOnly(['uid', 'at', 'status', 'kind', 'text', 'build', 'device', 'errors',
          'live', 'save', 'shot', 'ui'])
        && request.resource.data.at == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['bug', 'idea']
        && str(request.resource.data.text, 1000) && request.resource.data.text.size() > 0
        && str(request.resource.data.build, 64)
        && str(request.resource.data.device, 1000)
        && str(request.resource.data.errors, 4000)
        && (!('live' in request.resource.data) || str(request.resource.data.live, 4000))
        && (!('save' in request.resource.data) || str(request.resource.data.save, 99999))
        && (!('shot' in request.resource.data) || jpeg(request.resource.data.shot))
        // the picture as the player saw it, with the panels over the game: only with the one of just the game
        && (!('ui' in request.resource.data) || ('shot' in request.resource.data && jpeg(request.resource.data.ui)))
        // sent together with the player's count, which the rules below keep to 20 an hour
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;
    }

    match /limits/{uid} {
      // a new hour's count: the first report, or the first once an hour has passed since the count started
      function restart() {
        return request.resource.data.since == request.time && request.resource.data.n == 1
          && (resource == null || request.time > resource.data.since + duration.value(1, 'h'));
      }
      function counted() {
        return request.resource.data.keys().hasOnly(['last', 'since', 'n']) && request.resource.data.last == request.time;
      }
      allow get: if googleUser(uid);
      allow create: if googleUser(uid) && counted() && restart();
      allow update: if googleUser(uid) && counted()
        && request.time > resource.data.last + duration.value(1, 's')
        && (restart() || (request.resource.data.since == resource.data.since
          && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 20));
    }
  }
}
